{
  "name": "@wfh/plink",
  "version": "0.14.0",
  "description": "Plink - A monorepo management tool links packages and projects, configures tsconfig.json for symlinks, provides command line extension ability",
  "main": "wfh/dist/index.js",
  "types": "wfh/dist/index.d.ts",
  "bin": {
    "plink": "bin/drcp.js",
    "plink2": "wfh/dist/plink2/cmd-client.js"
  },
  "plink": {},
  "scripts": {
    "tsc": "tsc",
    "build:node": "tsc -b tsconfig.json",
    "watch:node": "tsc -b tsconfig.json -w",
    "build:es": "tsc -b tsconfig-es5.json",
    "build:redux": "tsc -p ../redux-toolkit-observable/tsconfig-redux-toolkit.json && tsc -p ../redux-toolkit-observable/tsconfig-redux-toolkit-es.json",
    "build:rx": "tsc -b ../reactivizer/tsconfig-all.json",
    "watch:rx": "tsc -b -w ../reactivizer/tsconfig-all.json",
    "build:al": "tsc -b ../algorithms/tsconfig-all.json",
    "watch:al": "tsc -b -w ../algorithms/tsconfig-all.json",
    "clean": "rm -rf wfh/*.tsbuildinfo && rm -rf wfh/dist/*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liujingbreak/plink.git",
    "directory": "main"
  },
  "author": "LJ",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/liujingbreak/plink/issues"
  },
  "homepage": "https://github.com/liujingbreak/plink",
  "engines": {
    "node": ">=8.0.0"
  },
  "dependencies": {
    "@types/js-yaml": "3.10.1",
    "@types/lodash": "^4.14.92",
    "source-map-support": "~0.5.16",
    "chalk": "^4.1.0",
    "fs-extra": "^5.0.0",
    "@types/fs-extra": "5.0.4",
    "@types/glob": "^7.1.1",
    "glob": "^7.1.2",
    "cli-table3": "^0.6.0",
    "js-yaml": "^3.10.0",
    "lodash": "^4.17.21",
    "lru-cache": "^5.1.1",
    "os-locale": "^5.0.0",
    "rxjs": "^7.8.1",
    "semver": "^7.3.2",
    "tslint": "^5.9.1",
    "typescript": "^5.5.4",
    "yamlify": "^0.2.0",
    "yamljs": "^0.3.0",
    "@types/yamljs": "^0.2.31",
    "commander": "~8.2.0",
    "@reduxjs/toolkit": "~1.9.5",
    "redux-observable": "~2.0.0",
    "log4js": "~6.6.1",
    "cfonts": "~2.8.6",
    "tslib": "^2.5.0",
    "@types/node": "^22.5.5",
    "serialize-javascript": "~5.0.1",
    "@types/serialize-javascript": "~5.0.0",
    "strip-ansi": "~6.0.0",
    "chokidar": "^3.5.2",
    "gl-matrix": "^3.4.3",
    "anymatch": "^3.1.2"
  },
  "devDependencies": {
    "@types/react-redux": "^7.1.16",
    "@types/react": "^17.0.5",
    "@types/semver": "^7.3.4",
    "@types/lru-cache": "^5.1.0",
    "@jest/globals": "^29.5.0"
  }
}
