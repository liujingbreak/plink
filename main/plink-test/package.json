{
  "name": "@wfh/plink-test",
  "version": "1.0.0",
  "description": "Plink test cases for Jest",
  "main": "index.js",
  "author": "LJ",
  "license": "MIT",
  "plink": {
    "tsc": {
      "src": "src"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "watch": "tsc -b -w tsconfig.json",
    "jest": "echo 'You need run environment setup: source set-jest-env.sh' && jest -c dist/jest.config.js --runTestsByPath"
  },
  "devDependencies": {
    "@types/resolve": "^1.20.2",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "resolve": "^1.22.1"
  }
}
