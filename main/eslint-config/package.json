{
  "name": "@wfh/eslint-config",
  "version": "1.0.1",
  "description": "Eslint configuration based on create-reac-app's eslint-config-react-app  with extra typescript-eslint/tslint configuration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "type": "module",
  "files": ["dist/**/*"],
  "types": "dist/index.d.ts",
  "dependencies": {
    "eslint": "^9.23.0",
    "@eslint/js": "^9.23.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.28.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@eslint-stylistic/metadata": "^4.2.0"
  },
  "--obsolete": {
    "eslint-config-react-app": "^7.0.1",
    "@typescript-eslint/eslint-plugin-tslint": "^7.0.2",
    "eslint-plugin-jsdoc": "^50.6.9",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "tslint": "^6.1.3"
  },
  "keywords": [
    "eslint",
    "tslint"
