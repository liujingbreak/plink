{
  "extends": "./tsconfig-node.json",
  "references": [
    {"path": "../algorithms/tsconfig-es.json"}
  ],
  "compilerOptions": {
    "module": "ESNext",
    "outDir": "es",
    "strict": true,
    "inlineSources": true,
    "moduleResolution": "Node",
    "paths": {
      "@wfh/algorithms/*": [
        "../algorithms/src/*"
      ],
      "@wfh/algorithms": [
        "../algorithms/src"
      ]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/nodejs-utils.ts",
    "src/__tests__/**/*",
    "es/**/*.ts",
    "dist/**/*.ts"
  ]
}
