{
  "name": "plink-mono",
  "description": "This is a monorepo package, not for publishing",
  "version": "1.0.0",
  "private": true,
  "packages": [
    "src",
    "main",
    "doc-app",
    "server-tool-space/conf",
    "conf"
  ],
  "workspaces": [
    "main/plink",
    "main/algorithms",
    "main/plink-cli",
    "main/plink-test",
    "main/terminal-ui",
    "main/reactivizer",
    "main/eslint-config",
    "main/redux-toolkit-observable",
    "main/require-injector",
    "main/thread-promise-pool"
  ],
  "plink": {
    "externalRepo": ["../cvs"],
    "## noModuleSymlink": ["main/packages"]
  },
  "scripts": {
    "plink": "plink",
    "link-plink": "node main/bin/link.js",
    "lint-wfh": "eslint  -c eslint.config.mjs --ext .ts main/plink/wfh/src",
    "lint-redux": "eslint  -c eslint.config.mjs --ext .ts main/redux-toolkit-observable",
    "lint-thread": "eslint  -c eslint.config.mjs --ext .ts main/thread-promise-pool",
    "lint-file-debug": "eslint  -c eslint.config.mjs --debug --print-config",
    "lint-file": "eslint  -c eslint.config.mjs --debug"
  }
}
